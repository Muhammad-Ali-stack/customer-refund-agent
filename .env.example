# Copy to .env and fill in. Never commit .env.

# --- Option A: Google AI Studio (simplest) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=PASTE_YOUR_API_KEY_HERE

# --- Option B: Vertex AI ---
# Comment out GOOGLE_API_KEY above, uncomment below, then run:
#   gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=<your-project-id>
# GOOGLE_CLOUD_LOCATION=global

# Model used by the review agent (explanations only, never eligibility).
MODEL_NAME=gemini-3.5-flash

# Keep ADK sessions in memory so every restart starts clean.
ADK_DISABLE_LOCAL_STORAGE=1

# Approval UI settings (defaults shown).
BACKEND_URL=http://localhost:8080
APP_NAME=refund_agent
PUBSUB_SUBSCRIPTION=test-sub
USE_SERVICE_AUTH=false
FRONTEND_PORT=8081
